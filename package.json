{
  "name": "industrial-training-lms",
  "version": "1.0.0",
  "description": "Simplified Learning Management System (LMS) - DataPollex Ltd. Assessment Task",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "author": "Assessment Candidate",
  "license": "ISC"
}
